.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
extensionDevelopmentScriptsAndArtifacts/**
developmentSupportScripts/**
force-app/**
