sfdx-project.json

# The picklist dependency framework runtime classes ARE shipped: the "Generate Picklist
# Dependency Tests" command scaffolds them into the user's package directory alongside the
# generated PicklistDependencySpecs.cls, which would not compile without them. force-app
# stays the single source of truth so the shipped copies cannot drift. Test classes, the
# stub source, and the placeholder PicklistDependencySpecs.cls are deliberately NOT shipped.
!force-app/main/default/classes/IPicklistDependencySource.cls
!force-app/main/default/classes/IPicklistDependencySource.cls-meta.xml
!force-app/main/default/classes/PicklistDependencySpec.cls
!force-app/main/default/classes/PicklistDependencySpec.cls-meta.xml
!force-app/main/default/classes/PicklistDependencySnapshot.cls
!force-app/main/default/classes/PicklistDependencySnapshot.cls-meta.xml
!force-app/main/default/classes/PicklistDependencyReport.cls
!force-app/main/default/classes/PicklistDependencyReport.cls-meta.xml
!force-app/main/default/classes/PicklistDependencyValidator.cls
!force-app/main/default/classes/PicklistDependencyValidator.cls-meta.xml
!force-app/main/default/classes/SchemaPicklistDependencySource.cls
!force-app/main/default/classes/SchemaPicklistDependencySource.cls-meta.xml

# Salesforce CLI local tooling and per-org source-tracking state. These are created by the
# CLI alongside the DX project, are machine-local, and must never be published: .sfdx alone
# carries a multi-megabyte apex.db plus the whole StandardApexLibrary, and .sf/orgs/<ORG_ID>/
# names the packaging developer's org and its metadata.
.sfdx/**
.sf/**

# Jest coverage output. Being in .gitignore does NOT exclude it here — vsce packages the
# working directory, not the git index.
coverage/**

# Repo automation, not extension runtime.
.claude/**
.github/**
