.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
esbuild.js
esbuild.test.js
**/*.map
**/*.ts
**/.vscode-test.*
extensionDevelopmentScriptsAndArtifacts/**
developmentSupportScripts/**
apexPicklistDependencyFramework/**
scripts/picklist-dependency-demo/**

# The picklist dependency framework runtime classes ARE shipped: the "Generate Picklist
# Dependency Tests" command scaffolds them into the user's package directory alongside the
# generated SDTPLDSpecs.cls and its per-object spec classes, which would not compile without
# them. apexPicklistDependencyFramework/ stays the single source of truth so the shipped
# copies cannot drift.
#
# They live in their own directory so this is ONE negation rather than a per-file list that
# silently fails to ship a class somebody forgets to add. Anything outside that directory --
# the framework's own test classes under frameworkApexTests/ and the directory README --
# is therefore excluded by construction rather than by omission.
!apexPicklistDependencyFramework/SDTPicklistDependencyFramework/**

# Salesforce CLI local tooling and per-org source-tracking state. These are created by the
# CLI alongside the DX project, are machine-local, and must never be published: .sfdx alone
# carries a multi-megabyte apex.db plus the whole StandardApexLibrary, and .sf/orgs/<ORG_ID>/
# names the packaging developer's org and its metadata.
.sfdx/**
.sf/**

# Jest coverage output. Being in .gitignore does NOT exclude it here — vsce packages the
# working directory, not the git index.
coverage/**

# Repo automation, not extension runtime.
.claude/**
.github/**

# Repo-side documentation. None of it is read at runtime, and the design record in docs/ is an
# internal architecture and security-review document that has no business on a user's disk.
docs/**
CLAUDE.md
tasks.md
jest.config.js
jestSetup/**

# A debug dump of an ObjectInfoWrapper from a development run. 160KB, referenced by no code.
wrappers.json

# Output the picklist dependency check writes into the workspace. Being untracked does NOT
# exclude it, for the same reason coverage/ is listed above: vsce packages the working
# directory, not the git index. Packaging from a machine that has run the demo would otherwise
# publish that machine's scratch org names and run reports.
treecipe/**

# Compiled Jest output and test doubles. Since #137 "out/" holds one bundled file and tsc emits
# nothing, so these match nothing on a clean build -- they are kept because vsce packages the
# WORKING DIRECTORY rather than the git index, and a checkout that ran the old tsc build before
# this change still has that tree on disk. esbuild.js clears out/ for the same reason.
out/*.test.js
out/**/*.test.js
out/**/tests/**
