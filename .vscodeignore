.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
extensionDevelopmentScriptsAndArtifacts/**
developmentSupportScripts/**
force-app/**
scripts/apex/**
scripts/picklist-dependency-demo/**
sfdx-project.json

# The picklist dependency framework runtime classes ARE shipped: the "Generate Picklist
# Dependency Tests" command scaffolds them into the user's package directory alongside the
# generated PicklistDependencySpecs.cls, which would not compile without them. force-app
# stays the single source of truth so the shipped copies cannot drift.
#
# They live in their own directory so this is ONE negation rather than a per-file list that
# silently fails to ship a class somebody forgets to add. Anything outside that directory --
# the framework's own test classes, the stub source, and the placeholder
# PicklistDependencySpecs.cls -- is therefore excluded by construction rather than by omission.
!force-app/main/default/classes/PicklistDependencyFramework/**

# Salesforce CLI local tooling and per-org source-tracking state. These are created by the
# CLI alongside the DX project, are machine-local, and must never be published: .sfdx alone
# carries a multi-megabyte apex.db plus the whole StandardApexLibrary, and .sf/orgs/<ORG_ID>/
# names the packaging developer's org and its metadata.
.sfdx/**
.sf/**

# Jest coverage output. Being in .gitignore does NOT exclude it here — vsce packages the
# working directory, not the git index.
coverage/**

# Repo automation, not extension runtime.
.claude/**
.github/**
