<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Contact_Phone__c, "\\(\\d{3}\\) \\d{3}-\\d{4}"))</errorConditionFormula>
    <errorMessage>Phone Format failed.</errorMessage>
</ValidationRule>
