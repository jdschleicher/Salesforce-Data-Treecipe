<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Code_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Code__c, "[A-Z]{3}-\\d{4}"))</errorConditionFormula>
    <errorMessage>Code Format failed.</errorMessage>
</ValidationRule>
